# Plantilla para configurar el ambiente. Copia este archivo como .env y completa.
SECRET_KEY=genera_una_con_django_utils
DEBUG=True

# Hosts y orígenes separados por coma. Nunca uses * con credenciales.
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# En producción usa HTTPS y conserva AUTH_COOKIE_SECURE=True.
SECURE_SSL_REDIRECT=False
TRUST_PROXY_SSL=False
AUTH_COOKIE_SECURE=False
AUTH_COOKIE_SAMESITE=Lax

# En desarrollo apunta a PostgreSQL local; en producción apuntará a Neon.
DATABASE_URL=postgres://USUARIO:CONTRASENA@localhost:5432/hydroemcol

# Base local para los enlaces privados de seguimiento (sin dominio de producción).
SEGUIMIENTO_BASE_URL=http://localhost:5173

# Cloudflare R2 privado. Déjalo desactivado en desarrollo local.
R2_ENABLED=False
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
R2_URL_EXPIRATION_SECONDS=900
